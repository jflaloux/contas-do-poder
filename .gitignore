# Cache das páginas e arquivos baixados (pode ser recriado a qualquer momento)
dados/cache/
__pycache__/
*.pyc
.venv/
.DS_Store

# Intermediários que os robôs recriam
dados/brutos/
dados/processados/lancamentos.csv

# O que o Cloudflare Pages publica (node publicacao/gerar.mjs recria a partir de site/)
publicar/

# Notas pessoais (imprensa, decisões): ficam só no computador
NOTAS-PRIVADAS.md

# Recados entre as conversas do site e dos dados (TAREFA-SITE-*, TAREFA-DADOS-*): ficam só no computador
TAREFA-*.txt

# Claude Code: memória de cada agente e ajustes pessoais (ficam só no computador)
.claude/agent-memory-local/
.claude/settings.local.json

# Rascunhos de e-mail do agente de divulgação: ficam só no computador
RASCUNHOS-DIVULGACAO.md

# Cópia local da caixa do Gmail do projeto (rotina/caixa_gmail.py): fica só no computador
CAIXA-CONTATO/

# Log dos envios aprovados no painel (rotina/enviar_gmail.py) e a trava contra envio duplo: ficam só no computador
ENVIOS-CONTATO.jsonl
